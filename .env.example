# ==============================================================================
# Veya Luma — Environment Configuration (.env.example)
# Phase 0 Baseline
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Veya Luma"
API_V1_STR=/api/v1

# Security & CORS
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long_12345
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
GUEST_SESSION_EXPIRE_DAYS=30
AUTH_COOKIE_NAME=veya_refresh_token
AUTH_COOKIE_SECURE=false

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database
# Local standard connection:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veya_luma
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/veya_luma
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/veya_luma

# Redis Cache / Queue Configuration (Phase 0 Placeholder)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# TMDB Provider Configuration (Non-commercial primary metadata source)
# Required for live TMDB API ingestion; mock/offline pipelines function without credentials.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_REQUEST_TIMEOUT_SECONDS=15.0
TMDB_MAX_REQUESTS_PER_SECOND=20.0
TMDB_MAX_RETRIES=3
TMDB_BACKOFF_FACTOR=1.5
TMDB_DEFAULT_PAGE_LIMIT=2
TMDB_DEFAULT_RECORD_LIMIT=40

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

